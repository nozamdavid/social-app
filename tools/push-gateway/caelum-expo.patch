+func TestFCMSend_CaelumExpoPayload(t *testing.T) {
+	for _, reason := range []string{"like", "repost", "reply", "mention", "quote", "follow"} {
+		t.Run(reason, func(t *testing.T) {
+			var got fcmRequest
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				json.NewDecoder(r.Body).Decode(&got)
+				w.WriteHeader(200)
+			}))
+			defer srv.Close()
+			n := testNotification("test-device-token", "android")
+			n.AppID = "am.noz.caelum"
+			n.Data["reason"] = reason
+			n.Data["recipientDid"] = "did:plc:recipient"
+			n.Data["subject"] = "at://did:plc:recipient/app.bsky.feed.post/123"
+			f := newTestFCMSender(srv.URL)
+			f.SetDataOnly(true)
+			if err := f.Send(n); err != nil {
+				t.Fatal(err)
+			}
+			if got.Message.Notification != nil || got.Message.Android.Notification != nil {
+				t.Fatal("Caelum must receive data-only FCM messages")
+			}
+			if got.Message.Data["message"] != n.Body || got.Message.Data["title"] != n.Title {
+				t.Fatal("Expo display text missing")
+			}
+			var payload map[string]string
+			if err := json.Unmarshal([]byte(got.Message.Data["body"]), &payload); err != nil {
+				t.Fatal(err)
+			}
+			for k, v := range n.Data {
+				if payload[k] != v {
+					t.Fatalf("Expo tap payload lost %s", k)
+				}
+			}
+			if got.Message.Data["channelId"] != reason || got.Message.Data["reason"] != reason {
+				t.Fatal("native background handler requires flat reason and channelId")
+			}
+			if _, mutated := n.Data["body"]; mutated {
+				t.Fatal("sender mutated event data")
+			}
+		})
+	}
+}
