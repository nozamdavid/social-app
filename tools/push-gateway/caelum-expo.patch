+func TestPushPreferencesPersistAcrossRestart(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "test.db")
+	s, err := New(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := s.SetPushPreferences("did:plc:alice", map[string]bool{
+		"like":            false,
+		"like-via-repost": false,
+		"reply":           true,
+	}); err != nil {
+		t.Fatalf("SetPushPreferences failed: %v", err)
+	}
+	if !s.IsPushDisabled("did:plc:alice", "like") {
+		t.Error("expected like push to be disabled")
+	}
+	if !s.IsPushDisabled("did:plc:alice", "like-via-repost") {
+		t.Error("expected like-via-repost push to be disabled")
+	}
+	if s.IsPushDisabled("did:plc:alice", "reply") {
+		t.Error("expected reply push to remain enabled")
+	}
+	s.Close()
+
+	s2, err := New(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s2.Close()
+
+	if !s2.IsPushDisabled("did:plc:alice", "like") {
+		t.Error("expected disabled like preference to persist across restart")
+	}
+	if err := s2.SetPushPreferences("did:plc:alice", map[string]bool{
+		"like": true,
+	}); err != nil {
+		t.Fatalf("re-enabling like failed: %v", err)
+	}
+	if s2.IsPushDisabled("did:plc:alice", "like") {
+		t.Error("expected like push to be enabled after update")
+	}
+}
