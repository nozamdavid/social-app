+func (s *Store) SetPushPreferences(actorDID string, updates map[string]bool) error {
+	if len(updates) == 0 {
+		return nil
+	}
+
+	tx, err := s.db.Begin()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+
+	for reason, enabled := range updates {
+		enabledInt := 0
+		if enabled {
+			enabledInt = 1
+		}
+		if _, err := tx.Exec(
+			`INSERT OR REPLACE INTO notification_preferences (actor_did, reason, push_enabled, updated_at)
+			 VALUES (?, ?, ?, datetime('now'))`,
+			actorDID, reason, enabledInt,
+		); err != nil {
+			return err
+		}
+	}
+
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+
+	s.mu.Lock()
+	for reason, enabled := range updates {
+		if enabled {
+			if s.disabledReasons[actorDID] != nil {
+				delete(s.disabledReasons[actorDID], reason)
+				if len(s.disabledReasons[actorDID]) == 0 {
+					delete(s.disabledReasons, actorDID)
+				}
+			}
+		} else {
+			if s.disabledReasons[actorDID] == nil {
+				s.disabledReasons[actorDID] = make(map[string]bool)
+			}
+			s.disabledReasons[actorDID][reason] = true
+		}
+	}
+	s.mu.Unlock()
+
+	return nil
+}
+
+func (s *Store) IsPushDisabled(actorDID, reason string) bool {
+	if actorDID == "" || reason == "" {
+		return false
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	if s.disabledReasons[actorDID] == nil {
+		return false
+	}
+	return s.disabledReasons[actorDID][reason]
+}
+
+func (s *Store) GetDisabledPushReasons(actorDID string) map[string]bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := make(map[string]bool)
+	for reason, disabled := range s.disabledReasons[actorDID] {
+		if disabled {
+			out[reason] = true
+		}
+	}
+	return out
+}
+
 func (s *Store) Close() error {
 	return s.db.Close()
 }
